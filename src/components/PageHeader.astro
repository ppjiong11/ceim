---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<div class="page-header">
  <div class="wrap">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead measure">{lead}</p>}
    <slot />
  </div>
</div>

<style>
  .page-header {
    padding-block: clamp(3rem, 1.5rem + 6vw, 6.5rem) clamp(2rem, 1rem + 3vw, 3.5rem);
    border-bottom: 1px solid var(--rule);
  }
  h1 { font-size: var(--t-h1); max-width: 20ch; }
  .lead { margin-top: 1.4rem; }
</style>
