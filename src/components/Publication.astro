---
import type { CollectionEntry } from 'astro:content';

interface Props {
  pub: CollectionEntry<'publications'>['data'];
  /** Show the plain-language summary and a heavier layout. */
  detailed?: boolean;
}
const { pub, detailed = false } = Astro.props;

const href = pub.url ?? (pub.doi ? `https://doi.org/${pub.doi}` : undefined);

/**
 * Authors are stored with `**Name**` marking lab members, so the list can be
 * rendered with those names emphasised without a second data field.
 */
const authors = pub.authors.map((a) => {
  const isLab = a.startsWith('**') && a.endsWith('**');
  return { name: isLab ? a.slice(2, -2) : a, isLab };
});
---

<article class:list={['pub', { detailed }]}>
  <div class="year" aria-hidden="true">{pub.year}</div>

  <div class="body">
    <h3 class="title">
      {href
        ? <a href={href} rel="noopener" class="link-plain">{pub.title}</a>
        : pub.title}
    </h3>

    <p class="authors">
      {authors.map((a, i) => (
        <>
          <span class:list={{ lab: a.isLab }}>{a.name}</span>{i < authors.length - 1 ? ', ' : ''}
        </>
      ))}
    </p>

    <p class="meta">
      <em>{pub.journal}</em>
      {pub.volume && <> {pub.volume}</>}
      {pub.pages && <>, {pub.pages}</>}
      <> ({pub.year})</>
      {pub.type !== 'article' && <span class="tag">{pub.type}</span>}
    </p>

    {detailed && pub.summary && <p class="summary">{pub.summary}</p>}

    <p class="links">
      {pub.doi && <a href={`https://doi.org/${pub.doi}`} rel="noopener">DOI</a>}
      {pub.pmid && <a href={`https://pubmed.ncbi.nlm.nih.gov/${pub.pmid}/`} rel="noopener">PubMed</a>}
      {pub.url && !pub.doi && <a href={pub.url} rel="noopener">Link</a>}
    </p>
  </div>
</article>

<style>
  .pub {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0 1.5rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule);
  }
  .year {
    font-size: var(--t-small);
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
    padding-top: 0.3rem;
  }
  .title {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 550;
    line-height: 1.4;
    letter-spacing: 0;
    margin-bottom: 0.4rem;
  }
  .detailed .title { font-size: var(--t-h3); }
  .authors {
    font-size: var(--t-small);
    color: var(--ink-2);
    margin-bottom: 0.3rem;
    line-height: 1.55;
  }
  .authors .lab { color: var(--ink); font-weight: 600; }
  .meta { font-size: var(--t-small); color: var(--ink-3); margin-bottom: 0; }
  .summary {
    margin-top: 0.75rem;
    color: var(--ink-2);
    max-width: 62ch;
  }
  .tag {
    display: inline-block;
    margin-left: 0.6rem;
    font-size: var(--t-micro);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-wash);
    padding: 0.1rem 0.45rem;
    border-radius: 2px;
  }
  .links {
    display: flex;
    gap: 1rem;
    margin: 0.65rem 0 0;
    font-size: var(--t-small);
  }
  .links:empty { display: none; }
  .links a { text-decoration: none; color: var(--accent); }
  .links a:hover { text-decoration: underline; text-underline-offset: 0.2em; }

  @media (max-width: 620px) {
    .pub { grid-template-columns: 1fr; gap: 0; }
    .year { padding: 0 0 0.4rem; }
  }
</style>
