---
import { site, nav, url } from '../config';

const here = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const target = url(href).replace(/\/$/, '');
  return here === target || (href !== '/' && here.startsWith(target + '/'));
};
---

<header class="site-header">
  <div class="wrap bar">
    <div class="lockup">
      <a class="crest" href={site.institutionUrl} rel="noopener"
         aria-label={`${site.institution} — ${site.department}`}>
        <img src={url('/images/brand/polyu-logo.png')} alt="" width="480" height="92" />
      </a>

      <a class="brand" href={url('/')}>
        <span class="brand-name">{site.name}</span>
        <span class="brand-sub">{site.department}</span>
      </a>
    </div>

    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <span class="bars" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class:list={['nav-link', { current: isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const header = document.querySelector<HTMLElement>('.site-header');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('nav-open', !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 5rem;
  }

  /* Institution mark and group wordmark sit side by side, divided by a rule:
     the group reads as part of PolyU rather than as a separate brand. */
  .lockup { display: flex; align-items: center; gap: 1.1rem; min-width: 0; }

  .crest { display: block; flex: none; line-height: 0; }
  .crest img { width: 152px; height: auto; }
  .crest:hover { opacity: 0.72; }

  .brand {
    text-decoration: none;
    display: block;
    line-height: 1.15;
    padding-left: 1.1rem;
    border-left: 1px solid var(--rule);
  }
  /* The group name is long, so the wordmark is a deliberate two-line lockup
     rather than a single line that would crowd the navigation. */
  .brand-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.2;
    letter-spacing: -0.005em;
    max-width: 15ch;
    text-wrap: balance;
  }
  .brand-sub {
    display: block;
    font-size: 0.625rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-top: 0.3rem;
  }
  .brand:hover .brand-name { color: var(--accent); }

  .site-nav ul {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    text-decoration: none;
    font-size: var(--t-small);
    font-weight: 450;
    color: var(--ink-2);
    padding-block: 0.35rem;
    border-bottom: 1px solid transparent;
    transition: color .16s ease, border-color .16s ease;
  }
  .nav-link:hover { color: var(--ink); border-color: var(--rule); }
  .nav-link.current { color: var(--ink); border-color: var(--accent); }

  /* --- mobile ----------------------------------------------------------- */
  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 0.6rem;
    margin-right: -0.6rem;
    cursor: pointer;
    color: var(--ink);
  }
  .bars { display: block; width: 22px; }
  .bars i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform .2s ease, opacity .2s ease;
  }
  .bars i + i { margin-top: 6px; }

  @media (max-width: 1080px) {
    .crest img { width: 124px; }
  }

  @media (max-width: 900px) {
    .crest { display: none; }
    .brand { padding-left: 0; border-left: 0; }
  }

  @media (max-width: 800px) {
    .menu-toggle { display: block; }
    .site-nav {
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
      display: none;
    }
    :global(.site-header.nav-open) .site-nav { display: block; }
    .site-nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem var(--gutter) 1.5rem;
    }
    .site-nav li + li { border-top: 1px solid var(--rule); }
    .nav-link {
      display: block;
      padding: 0.85rem 0;
      font-size: 1.05rem;
      border-bottom: 0;
    }
    .nav-link.current { color: var(--accent); }
    :global(.site-header.nav-open) .bars i:first-child { transform: translateY(3.5px) rotate(45deg); }
    :global(.site-header.nav-open) .bars i:last-child  { transform: translateY(-3.5px) rotate(-45deg); }
  }
</style>
