---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PersonCard from '../components/PersonCard.astro';
import { url } from '../config';

const everyone = await getCollection('people', ({ data }) => !data.draft);

const current = everyone
  .filter((p) => !p.data.alumnus)
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));

const alumni = everyone
  .filter((p) => p.data.alumnus)
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));

const piEntry = current.find((p) => p.data.role === 'pi');
const PiBio = piEntry ? (await render(piEntry)).Content : null;

/** Role groups, in the order they appear on the page. */
const groups = [
  { role: 'postdoc',   label: 'Postdoctoral Fellows' },
  { role: 'phd',       label: 'PhD Students' },
  { role: 'mphil',     label: 'MPhil Students' },
  { role: 'ra',        label: 'Research Assistants' },
  { role: 'visiting',  label: 'Visiting Researchers' },
  { role: 'undergrad', label: 'Undergraduate Researchers' },
  { role: 'staff',     label: 'Staff' },
] as const;

const populated = groups
  .map((g) => ({ ...g, members: current.filter((p) => p.data.role === g.role) }))
  .filter((g) => g.members.length > 0);
---

<Base title="People" description="Members of the Chang Lab at PolyU Biomedical Engineering.">
  <PageHeader eyebrow="People" title="People" />

  {piEntry && (
    <section class="wrap pi-section">
      <div class="pi-grid">
        <div class="pi-card">
          <PersonCard person={piEntry} />
        </div>
        <div class="prose pi-bio">
          <h2>{piEntry.data.title}</h2>
          {PiBio && <PiBio />}
        </div>
      </div>
    </section>
  )}

  {populated.map((group) => (
    <section class="wrap group">
      <h2 class="group-title">{group.label}</h2>
      <div class="people-grid">
        {group.members.map((p) => <PersonCard person={p} />)}
      </div>
    </section>
  ))}

  {populated.length === 0 && (
    <section class="wrap group">
      <p class="empty">
        The lab is being built. Member profiles will appear here as people join —
        see <a href={url('/join')}>Join</a>.
      </p>
    </section>
  )}

  {alumni.length > 0 && (
    <section class="wrap group">
      <h2 class="group-title">Alumni</h2>
      <ul class="alumni">
        {alumni.map((p) => <PersonCard person={p} compact />)}
      </ul>
    </section>
  )}
</Base>

<style>
  .pi-section { padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem); }
  .pi-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 800px) {
    .pi-grid { grid-template-columns: minmax(0, 17rem) minmax(0, 1fr); }
  }
  .pi-card { max-width: 20rem; }
  .pi-bio h2 {
    font-family: var(--font-body);
    font-size: var(--t-micro);
    font-weight: 550;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.25rem;
  }

  .group { padding-block: clamp(2rem, 1rem + 3vw, 3.5rem); }
  .group + .group { border-top: 1px solid var(--rule); }
  .pi-section + .group { border-top: 1px solid var(--rule); }

  .group-title {
    font-family: var(--font-body);
    font-size: var(--t-micro);
    font-weight: 550;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 2rem;
  }

  .people-grid {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.75rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr));
  }

  .alumni { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--rule); }

  .empty { color: var(--ink-2); max-width: var(--measure); }
</style>
