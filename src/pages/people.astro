---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PersonCard from '../components/PersonCard.astro';
import { url } from '../config';

const everyone = await getCollection('people', ({ data }) => !data.draft);

const byOrder = (a: typeof everyone[number], b: typeof everyone[number]) =>
  a.data.order - b.data.order || a.data.name.localeCompare(b.data.name);

const current = everyone.filter((p) => !p.data.alumnus).sort(byOrder);
const alumni = everyone.filter((p) => p.data.alumnus).sort(byOrder);

/** Faculty get their full bio rendered; everyone else gets a card. */
const withBio = async (entry: typeof everyone[number]) => ({
  entry,
  Content: (await render(entry)).Content,
});

const director = current.find((p) => p.data.role === 'director');
const Director = director ? await withBio(director) : null;

const pis = await Promise.all(
  current.filter((p) => p.data.role === 'pi').map(withBio)
);

/** Role groups below faculty, in page order. */
const groups = [
  { role: 'postdoc',   label: 'Postdoctoral Fellows' },
  { role: 'phd',       label: 'PhD Students' },
  { role: 'mphil',     label: 'MPhil Students' },
  { role: 'ra',        label: 'Research Assistants' },
  { role: 'visiting',  label: 'Visiting Researchers' },
  { role: 'undergrad', label: 'Undergraduate Researchers' },
  { role: 'staff',     label: 'Staff' },
] as const;

const populated = groups
  .map((g) => ({ ...g, members: current.filter((p) => p.data.role === g.role) }))
  .filter((g) => g.members.length > 0);
---

<Base title="People" description="Faculty, researchers and students of the group.">
  <PageHeader eyebrow="People" title="People" />

  {Director && (
    <section class="wrap faculty lead-faculty">
      <div class="faculty-grid director">
        <div class="portrait">
          <PersonCard person={Director.entry} />
        </div>
        <div class="prose bio">
          <h2 class="rank">{Director.entry.data.title}</h2>
          <Director.Content />
        </div>
      </div>
    </section>
  )}

  {pis.length > 0 && (
    <section class="wrap faculty">
      <h2 class="group-title">Principal Investigators</h2>
      {pis.map(({ entry, Content }) => (
        <div class="faculty-grid pi">
          <div class="portrait">
            <PersonCard person={entry} />
          </div>
          <div class="prose bio">
            <Content />
          </div>
        </div>
      ))}
    </section>
  )}

  {populated.map((group) => (
    <section class="wrap group">
      <h2 class="group-title">{group.label}</h2>
      <div class="people-grid">
        {group.members.map((p) => <PersonCard person={p} />)}
      </div>
    </section>
  ))}

  {populated.length === 0 && (
    <section class="wrap group">
      <p class="empty">
        Student and postdoc profiles will appear here — see
        {' '}<a href={url('/join')}>Join</a>.
      </p>
    </section>
  )}

  {alumni.length > 0 && (
    <section class="wrap group">
      <h2 class="group-title">Alumni</h2>
      <ul class="alumni">
        {alumni.map((p) => <PersonCard person={p} compact />)}
      </ul>
    </section>
  )}
</Base>

<style>
  .faculty { padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem); }
  .faculty + .faculty,
  .faculty + .group,
  .group + .group { border-top: 1px solid var(--rule); }

  .faculty-grid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 800px) {
    .director { grid-template-columns: minmax(0, 17rem) minmax(0, 1fr); }
    .pi       { grid-template-columns: minmax(0, 13rem) minmax(0, 1fr); }
  }

  /* Each PI gets their own band so the bios do not run together. */
  .pi + .pi { margin-top: 2.75rem; padding-top: 2.75rem; border-top: 1px solid var(--rule); }

  .director .portrait { max-width: 20rem; }
  .pi .portrait { max-width: 15rem; }

  .rank {
    font-family: var(--font-body);
    font-size: var(--t-micro);
    font-weight: 550;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.25rem;
  }

  .bio { font-size: var(--t-body); }
  .pi .bio { font-size: var(--t-small); color: var(--ink-2); }

  .group { padding-block: clamp(2rem, 1rem + 3vw, 3.5rem); }

  .group-title {
    font-family: var(--font-body);
    font-size: var(--t-micro);
    font-weight: 550;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 2rem;
  }

  .people-grid {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.75rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr));
  }

  .alumni { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--rule); }
  .empty { color: var(--ink-2); max-width: var(--measure); }
</style>
