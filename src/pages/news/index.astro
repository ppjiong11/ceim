---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsCard from '../../components/NewsCard.astro';

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="News" description="News from the Chang Lab at PolyU Biomedical Engineering.">
  <PageHeader eyebrow="News" title="News" />

  <div class="wrap section">
    {news.length > 0
      ? <div class="list">{news.map((n) => <NewsCard item={n} />)}</div>
      : <p class="empty">Nothing yet.</p>}
  </div>
</Base>

<style>
  .list { border-bottom: 1px solid var(--rule); max-width: 52rem; }
  .empty { color: var(--ink-2); }
</style>
